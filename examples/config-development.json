{
  "mcpServers": {
    "git-manager": {
      "command": "node",
      "args": ["/path/to/claude-git-manager-mcp/dist/index.js"],
      "env": {
        "GIT_MANAGER_CONFIG": "{\"permissionLevel\":\"full\",\"safety\":{\"require_confirmation\":{\"destructive_operations\":true,\"branch_changes\":false,\"file_modifications\":false,\"git_commands\":[\"reset --hard\",\"clean -fd\",\"push --force\"]},\"backup_strategy\":{\"auto_stash\":true,\"create_snapshots\":true,\"max_rollback_depth\":10},\"validation\":{\"check_tests_before_commit\":false,\"lint_before_commit\":false,\"require_clean_working_dir\":false,\"protected_branches\":[\"main\",\"master\"]}}}"
      }
    }
  }
}
