{
  "name": "claude-git-manager-mcp",
  "version": "1.0.0",
  "description": "Git Repository Manager MCP for Claude Desktop with full repository control",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "claude-git-manager": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Raoof128/claude-git-manager-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Raoof128/claude-git-manager-mcp/issues"
  },
  "homepage": "https://github.com/Raoof128/claude-git-manager-mcp#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test && npm run lint",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "mcp",
    "git",
    "claude",
    "claude-desktop",
    "repository-manager",
    "version-control",
    "ai-assistant",
    "automation"
  ],
  "author": "Raoof Naushad",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "simple-git": "^3.25.0",
    "glob": "^10.3.10",
    "typescript": "^5.3.3",
    "zod": "^3.22.4",
    "fs-extra": "^11.2.0",
    "minimatch": "^9.0.3",
    "diff": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/fs-extra": "^11.0.4",
    "@types/diff": "^5.0.8",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
